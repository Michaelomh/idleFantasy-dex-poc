{
  "name": "PROTOTYPE Save Source",
  "short_name": "SaveSrc",
  "description": "Throwaway prototype for idleFantasy-dex ticket #4. Not the real app.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#11131a",
  "theme_color": "#11131a",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "save",
          "accept": [
            "application/json",
            "application/octet-stream",
            "text/plain",
            "text/*",
            ".json"
          ]
        }
      ]
    }
  }
}
